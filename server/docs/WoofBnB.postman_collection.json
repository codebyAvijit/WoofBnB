{
  "info": {
    "name": "WoofBnB Backend APIs",
    "_postman_id": "woofbnb-backend",
    "description": "API collection for WoofBnB backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Pet Sitters",
      "item": [
        {
          "name": "Register Pet Sitter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\":\"John Doe\",\n  \"email\":\"john@example.com\",\n  \"phone\":\"9876543210\",\n  \"bio\":\"Professional pet sitter\",\n  \"address\":\"Connaught Place, New Delhi\",\n  \"location\":{\n    \"type\":\"Point\",\n    \"coordinates\":[77.209,28.6139]\n  },\n  \"workingHours\":{\n    \"start\":\"09:00\",\n    \"end\":\"18:00\"\n  },\n  \"amenities\":[\"Dog Walking\",\"Medication\"]\n}"
            },
            "url": "{{baseUrl}}/petsitters"
          }
        },
        {
          "name": "Get All Pet Sitters",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/petsitters"
          }
        },
        {
          "name": "Nearby Pet Sitters",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/petsitters/nearby?lat=28.6139&lng=77.209&radius=5000"
          }
        }
      ]
    }
  ]
}